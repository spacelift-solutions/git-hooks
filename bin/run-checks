#!/usr/bin/env bash
set -uo pipefail

usage() {
  echo "usage: $0 <staged|repository> [repository]" >&2
}

mode="${1:-}"
case "${mode}" in
  staged | repository) ;;
  *)
    usage
    exit 2
    ;;
esac

if [[ -n "${2:-}" ]]; then
  repository="$(cd -- "$2" 2>/dev/null && pwd)"
else
  repository="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "run-checks must be run inside a Git repository" >&2
    exit 2
  }
fi

if ! git -C "${repository}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "not a Git repository: ${repository}" >&2
  exit 2
fi

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
checks_dir="${SPACELIFT_CHECKS_DIR:-${script_dir}/../checks}"
failures=0
check_count=0

for check in "${checks_dir}"/*; do
  [[ -f "${check}" && -x "${check}" ]] || continue
  check_count=$((check_count + 1))
  check_name="$(basename -- "${check}")"
  echo "==> ${check_name}"

  if ! "${check}" "${mode}" "${repository}"; then
    echo "FAILED: ${check_name}" >&2
    failures=$((failures + 1))
  fi
done

if [[ "${check_count}" -eq 0 ]]; then
  echo "no executable checks found in ${checks_dir}" >&2
  exit 2
fi

if [[ "${failures}" -ne 0 ]]; then
  echo "${failures} check(s) failed" >&2
  exit 1
fi

echo "All ${check_count} check(s) passed."
