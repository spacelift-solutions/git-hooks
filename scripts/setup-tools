#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_dir="$(cd -- "${script_dir}/.." && pwd)"

# The path is dynamic because this script is also copied into installed hooks.
# shellcheck disable=SC1091
source "${repo_dir}/config/tool-versions"

destination="${1:-}"
if [[ -z "${destination}" ]]; then
  echo "usage: $0 <destination>" >&2
  exit 2
fi

case "${GITLEAKS_VERSION}" in
  *[!0-9.]* | "")
    echo "invalid Gitleaks version: ${GITLEAKS_VERSION}" >&2
    exit 2
    ;;
esac

os="$(uname -s | tr '[:upper:]' '[:lower:]')"
case "${os}" in
  darwin | linux) ;;
  *)
    echo "unsupported operating system: ${os}" >&2
    exit 2
    ;;
esac

case "$(uname -m)" in
  arm64 | aarch64) arch="arm64" ;;
  x86_64 | amd64) arch="x64" ;;
  *)
    echo "unsupported architecture: $(uname -m)" >&2
    exit 2
    ;;
esac

mkdir -p "${destination}"

installed="${destination}/gitleaks"
if [[ -x "${installed}" ]] && [[ "$("${installed}" version)" == "${GITLEAKS_VERSION}" ]]; then
  exit 0
fi

archive="gitleaks_${GITLEAKS_VERSION}_${os}_${arch}.tar.gz"
checksums="gitleaks_${GITLEAKS_VERSION}_checksums.txt"
release_url="https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}"
temporary_dir="$(mktemp -d)"
trap 'rm -rf "${temporary_dir}"' EXIT

curl --fail --location --silent --show-error \
  --output "${temporary_dir}/${archive}" \
  "${release_url}/${archive}"
curl --fail --location --silent --show-error \
  --output "${temporary_dir}/${checksums}" \
  "${release_url}/${checksums}"

expected_checksum="$(
  awk -v archive="${archive}" '$2 == archive { print $1 }' "${temporary_dir}/${checksums}"
)"
if [[ -z "${expected_checksum}" ]]; then
  echo "no checksum published for ${archive}" >&2
  exit 1
fi

if command -v sha256sum >/dev/null 2>&1; then
  actual_checksum="$(sha256sum "${temporary_dir}/${archive}" | awk '{ print $1 }')"
else
  actual_checksum="$(shasum -a 256 "${temporary_dir}/${archive}" | awk '{ print $1 }')"
fi

if [[ "${actual_checksum}" != "${expected_checksum}" ]]; then
  echo "checksum verification failed for ${archive}" >&2
  exit 1
fi

tar -xzf "${temporary_dir}/${archive}" -C "${temporary_dir}" gitleaks
install -m 0755 "${temporary_dir}/gitleaks" "${installed}"
