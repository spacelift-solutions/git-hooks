#!/usr/bin/env bash
set -euo pipefail

readonly REVIEW_RULESET_NAME="Require The Four Ghostman review"
readonly CHECK_RULESET_NAME="Require Spacelift repository checks"
readonly REVIEWER_TEAM="the-four-ghostman"
readonly REQUIRED_CHECK="Spacelift repository checks"
readonly WORKFLOW_PATH=".github/workflows/spacelift-repository-checks.yml"

usage() {
  echo "usage: $0 [--dry-run] [--rulesets-only] <owner/repository>" >&2
}

dry_run=false
rulesets_only=false
while [[ "${1:-}" == --* ]]; do
  case "$1" in
    --dry-run) dry_run=true ;;
    --rulesets-only) rulesets_only=true ;;
    *)
      usage
      exit 2
      ;;
  esac
  shift
done

repository="${1:-}"
if [[ -z "${repository}" || "${repository}" != */* || -n "${2:-}" ]]; then
  usage
  exit 2
fi

for dependency in gh jq base64; do
  if ! command -v "${dependency}" >/dev/null 2>&1; then
    echo "required command is unavailable: ${dependency}" >&2
    exit 2
  fi
done

owner="${repository%%/*}"
default_branch="$(gh api "repos/${repository}" --jq .default_branch)"
if [[ "${default_branch}" != "main" ]]; then
  echo "${repository} uses ${default_branch} as its default branch; expected main" >&2
  exit 1
fi

team_id="$(gh api "orgs/${owner}/teams/${REVIEWER_TEAM}" --jq .id)"

temporary_dir="$(mktemp -d)"
trap 'rm -rf "${temporary_dir}"' EXIT

if [[ "${rulesets_only}" == false ]]; then
workflow_file="${temporary_dir}/workflow.yml"
cat >"${workflow_file}" <<'EOF'
# Managed by spacelift-solutions/git-hooks.
name: Repository checks

on:
  pull_request:
    branches:
      - main
  push:
    branches:
      - main

permissions:
  contents: read

jobs:
  checks:
    name: Spacelift repository checks
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0

      - uses: spacelift-solutions/git-hooks@v1
EOF

contents_endpoint="repos/${repository}/contents/${WORKFLOW_PATH}"
workflow_sha=""
metadata_error="${temporary_dir}/metadata-error"

if workflow_metadata="$(
  gh api "${contents_endpoint}?ref=main" 2>"${metadata_error}"
)"; then
  workflow_sha="$(jq -r .sha <<<"${workflow_metadata}")"
  existing_workflow="$(
    gh api -H "Accept: application/vnd.github.raw+json" \
      "${contents_endpoint}?ref=main"
  )"

  if [[ "${existing_workflow}" == "$(cat "${workflow_file}")" ]]; then
    echo "Workflow is already current in ${repository}."
    workflow_sha="unchanged"
  elif ! grep -qF "Managed by spacelift-solutions/git-hooks." \
    <<<"${existing_workflow}"; then
    echo "refusing to replace unmanaged workflow: ${WORKFLOW_PATH}" >&2
    exit 1
  fi
elif ! grep -qF "(HTTP 404)" "${metadata_error}"; then
  cat "${metadata_error}" >&2
  exit 1
fi

if [[ "${workflow_sha}" != "unchanged" ]]; then
  workflow_payload="${temporary_dir}/workflow-payload.json"
  encoded_workflow="$(base64 <"${workflow_file}" | tr -d '\n')"

  jq -n \
    --arg message "Configure Spacelift repository checks" \
    --arg content "${encoded_workflow}" \
    --arg branch main \
    --arg sha "${workflow_sha}" \
    '{
      message: $message,
      content: $content,
      branch: $branch
    } + if $sha == "" then {} else {sha: $sha} end' \
    >"${workflow_payload}"

  if [[ "${dry_run}" == true ]]; then
    echo "Would write ${WORKFLOW_PATH} to ${repository}."
  else
    gh api --method PUT "${contents_endpoint}" \
      --input "${workflow_payload}" >/dev/null
    echo "Installed ${WORKFLOW_PATH} in ${repository}."
  fi
fi
fi

review_ruleset_payload="${temporary_dir}/review-ruleset.json"
jq -n \
  --arg name "${REVIEW_RULESET_NAME}" \
  --argjson team_id "${team_id}" \
  '{
    name: $name,
    target: "branch",
    enforcement: "active",
    bypass_actors: [
      {
        actor_id: $team_id,
        actor_type: "Team",
        bypass_mode: "always"
      }
    ],
    conditions: {
      ref_name: {
        include: ["refs/heads/main"],
        exclude: []
      }
    },
    rules: [
      {
        type: "pull_request",
        parameters: {
          required_approving_review_count: 0,
          dismiss_stale_reviews_on_push: true,
          required_reviewers: [
            {
              minimum_approvals: 1,
              file_patterns: ["*"],
              reviewer: {
                id: $team_id,
                type: "Team"
              }
            }
          ],
          require_code_owner_review: true,
          dismissal_restriction: {
            enabled: false,
            allowed_actors: []
          },
          require_last_push_approval: false,
          required_review_thread_resolution: false,
          require_extra_approval_for_unattributed_changes: true,
          allowed_merge_methods: ["merge", "squash", "rebase"]
        }
      }
    ]
  }' >"${review_ruleset_payload}"

check_ruleset_payload="${temporary_dir}/check-ruleset.json"
jq -n \
  --arg name "${CHECK_RULESET_NAME}" \
  --arg check "${REQUIRED_CHECK}" \
  --argjson team_id "${team_id}" \
  '{
    name: $name,
    target: "branch",
    enforcement: "active",
    bypass_actors: [
      {
        actor_id: $team_id,
        actor_type: "Team",
        bypass_mode: "always"
      }
    ],
    conditions: {
      ref_name: {
        include: ["refs/heads/main"],
        exclude: []
      }
    },
    rules: [
      {
        type: "required_status_checks",
        parameters: {
          required_status_checks: [
            {
              context: $check
            }
          ],
          strict_required_status_checks_policy: true,
          do_not_enforce_on_create: false
        }
      }
    ]
  }' >"${check_ruleset_payload}"

existing_rulesets="$(gh api "repos/${repository}/rulesets")"

upsert_ruleset() {
  local name="$1"
  local payload="$2"
  local ruleset_id

  ruleset_id="$(
    jq -r --arg name "${name}" \
      '.[] | select(.name == $name and .source_type == "Repository") | .id' \
      <<<"${existing_rulesets}" |
      awk 'NR == 1'
  )"

  if [[ "${dry_run}" == true ]]; then
    if [[ -n "${ruleset_id}" ]]; then
      echo "Would update ruleset ${ruleset_id} in ${repository}:"
    else
      echo "Would create ruleset in ${repository}:"
    fi
    jq . "${payload}"
  elif [[ -n "${ruleset_id}" ]]; then
    gh api --method PUT "repos/${repository}/rulesets/${ruleset_id}" \
      --input "${payload}" >/dev/null
    echo "Updated ${name} in ${repository}."
  else
    gh api --method POST "repos/${repository}/rulesets" \
      --input "${payload}" >/dev/null
    echo "Created ${name} in ${repository}."
  fi
}

upsert_ruleset "${REVIEW_RULESET_NAME}" "${review_ruleset_payload}"
upsert_ruleset "${CHECK_RULESET_NAME}" "${check_ruleset_payload}"
