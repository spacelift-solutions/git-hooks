#!/usr/bin/env bash
set -euo pipefail

mode="${1:-}"
repository="${2:-}"

if ! command -v betterleaks >/dev/null 2>&1; then
  echo "betterleaks is unavailable; run scripts/setup-tools or reinstall the shared hooks" >&2
  exit 2
fi

check_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
shared_config="$(cd -- "${check_dir}/../config" && pwd)/betterleaks.toml"
config_arguments=()

if [[ -z "${BETTERLEAKS_CONFIG:-}" &&
  -z "${BETTERLEAKS_CONFIG_TOML:-}" &&
  -z "${GITLEAKS_CONFIG:-}" &&
  -z "${GITLEAKS_CONFIG_TOML:-}" &&
  ! -f "${repository}/.betterleaks.toml" &&
  ! -f "${repository}/.gitleaks.toml" ]]; then
  config_arguments=(--config "${shared_config}")
fi

common_arguments=(
  git
  "${config_arguments[@]}"
  --redact
  --no-banner
)

case "${mode}" in
  staged)
    betterleaks "${common_arguments[@]}" --staged "${repository}"
    ;;
  repository)
    betterleaks "${common_arguments[@]}" "${repository}"
    ;;
  *)
    echo "unsupported check mode: ${mode}" >&2
    exit 2
    ;;
esac
