#!/usr/bin/env bash
set -euo pipefail

source_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [[ "$#" -ne 0 ]]; then
  echo "usage: $0" >&2
  exit 2
fi

data_home="${XDG_DATA_HOME:-${HOME}/.local/share}"
managed_root="${data_home}/spacelift/repository-checks"
managed_hooks_dir="${managed_root}/hooks"

if [[ -e "${managed_root}" && ! -f "${managed_root}/.managed" ]]; then
  echo "refusing to replace unmanaged directory: ${managed_root}" >&2
  exit 1
fi

previous_hook="$(
  git config --global --path --get spacelift.previousPreCommitHook || true
)"
configured_hooks_dir="$(
  git config --global --path --get core.hooksPath || true
)"
if [[ "${configured_hooks_dir}" != "${managed_hooks_dir}" ]]; then
  previous_hook=""
  if [[ -n "${configured_hooks_dir}" && "${configured_hooks_dir}" != /* ]]; then
    echo "cannot safely chain relative global hooks path: ${configured_hooks_dir}" >&2
    echo "configure an absolute core.hooksPath, then run this installer again" >&2
    exit 1
  fi
  if [[ -x "${configured_hooks_dir}/pre-commit" ]]; then
    previous_hook="${configured_hooks_dir}/pre-commit"
  fi
fi

mkdir -p "$(dirname -- "${managed_root}")"
temporary_root="$(mktemp -d "${managed_root}.tmp.XXXXXX")"
trap 'rm -rf "${temporary_root}"' EXIT

mkdir -p "${temporary_root}/bin" "${temporary_root}/checks" \
  "${temporary_root}/config" "${temporary_root}/hooks" \
  "${temporary_root}/scripts"
cp "${source_dir}/bin/run-checks" "${temporary_root}/bin/"
cp "${source_dir}/checks/"* "${temporary_root}/checks/"
cp "${source_dir}/config/betterleaks.toml" "${temporary_root}/config/"
cp "${source_dir}/Brewfile" "${temporary_root}/"
cp "${source_dir}/hooks/pre-commit" "${temporary_root}/hooks/"
cp "${source_dir}/scripts/setup-tools" "${temporary_root}/scripts/"

"${source_dir}/scripts/setup-tools"

revision="$(git -C "${source_dir}" rev-parse HEAD 2>/dev/null || echo unknown)"
printf '%s\n' "${revision}" >"${temporary_root}/.managed"

if [[ -d "${managed_root}" ]]; then
  backup_root="${managed_root}.backup.$$"
  mv "${managed_root}" "${backup_root}"
  if ! mv "${temporary_root}" "${managed_root}"; then
    mv "${backup_root}" "${managed_root}"
    exit 1
  fi
  rm -rf "${backup_root}"
else
  mv "${temporary_root}" "${managed_root}"
fi

git config --global core.hooksPath "${managed_hooks_dir}"
if [[ -n "${previous_hook}" ]]; then
  git config --global \
    spacelift.previousPreCommitHook "${previous_hook}"
else
  git config --global \
    --unset-all spacelift.previousPreCommitHook 2>/dev/null || true
fi

echo "Installed shared checks in ${managed_root}"
echo "Configured global core.hooksPath as ${managed_hooks_dir}"
if [[ -n "${previous_hook}" ]]; then
  echo "The managed hook will run existing hook ${previous_hook} first"
fi
